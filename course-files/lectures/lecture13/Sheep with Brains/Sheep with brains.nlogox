  ]
]
display</button>
    <plot x="0" autoPlotX="true" yMax="1.0" autoPlotY="true" y="597" xMin="0.0" height="192" legend="true" xMax="1.0" yMin="0.0" width="350" display="smoothed efficiency">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="sheep" color="-13345367" legend="true">
