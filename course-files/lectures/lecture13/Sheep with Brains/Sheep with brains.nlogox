      </pen>
    </plot>
    <monitor x="285" precision="17" y="467" height="60" fontSize="11" width="100" display="sheep">count sheep</monitor>
    <monitor x="285" precision="17" y="532" height="60" fontSize="11" width="100" display="wolves">count wolves</monitor>
    <button x="513" y="543" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="125" display="update-subject">ask turtle-set subject [ __ignore sense ]</button>
