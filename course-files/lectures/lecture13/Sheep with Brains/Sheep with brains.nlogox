  <previewCommands>setup
set grass? true
repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="experiment" repetitions="10" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="50000">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition>(not any? sheep) or (not any? wolves)</exitCondition>
      <metrics>
        <metric>count sheep</metric>
        <metric>count wolves</metric>
        <metric>grass</metric>
        <metric>sheep-towards-grass</metric>
        <metric>sheep-towards-sheep</metric>
        <metric>sheep-towards-wolves</metric>
        <metric>wolves-towards-grass</metric>
        <metric>wolves-towards-sheep</metric>
        <metric>wolves-towards-wolves</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="middle-layers">
          <value value="&quot;[9]&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="wolf-gain-from-food">
          <value value="20"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="grass?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="show-energy?">
          <value value="false"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="reproduce-%">
          <value value="4"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="fov">
          <value value="120"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="initial-number-wolves">
          <value value="50"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="vision">
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="initial-number-sheep">
          <value value="100"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="sheep-gain-from-food">
          <value value="4"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="grass-regrowth-time">
          <value value="30"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
